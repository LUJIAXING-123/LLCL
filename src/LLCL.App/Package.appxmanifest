<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    IgnorableNamespaces="uap rescap desktop6">

    <!-- 版本号由 build/version.json 在打包时替换 -->
    <Identity
        Name="LLSTUDIO.LLCraftLauncher"
        Publisher="CN=LL STUDIO"
        Version="0.1.0.1"
        ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>LL Craft Launcher</DisplayName>
        <PublisherDisplayName>LL STUDIO</PublisherDisplayName>
        <Logo>PackageAssets\StoreLogo.png</Logo>
        <Description>Minecraft 启动器</Description>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0"
                            MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <Resources>
        <Resource Language="zh-CN" />
        <Resource Language="en-US" />
    </Resources>

    <Applications>
        <Application Id="LLCL" Executable="LLCL.exe" EntryPoint="LLCL.App">
            <uap:VisualElements
                DisplayName="LL Craft Launcher"
                Description="Minecraft 启动器"
                BackgroundColor="transparent"
                Square150x150Logo="PackageAssets\Square150x150Logo.png"
                Square44x44Logo="PackageAssets\Square44x44Logo.png">
                <uap:DefaultTile
                    Wide310x150Logo="PackageAssets\Wide310x150Logo.png"
                    Square71x71Logo="PackageAssets\Square71x71Logo.png"
                    Square310x310Logo="PackageAssets\Square310x310Logo.png" />
                <uap:SplashScreen Image="PackageAssets\SplashScreen.png" />
            </uap:VisualElements>
            <Extensions>
                <!-- 允许以普通 Win32 方式运行（非 UWP 沙箱） -->
                <desktop6:Extension Category="windows.fullTrustProcess" Executable="LLCL.exe" />
            </Extensions>
        </Application>
    </Applications>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
        <Capability Name="internetClient" />
        <Capability Name="privateNetworkClientServer" />
    </Capabilities>
</Package>
