<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Style="{StaticResource SectionHeaderTextStyle}" />

        <NavigationView Grid.Row="1"
                        x:Name="SettingsNav"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="200"
                        SelectionChanged="SettingsNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="账号" Tag="account" />
                <NavigationViewItem Content="启动" Tag="launch" />
                <NavigationViewItem Content="下载" Tag="download" />
                <NavigationViewItem Content="联机" Tag="link" />
                <NavigationViewItem Content="启动器" Tag="launcher" />
            </NavigationView.MenuItems>
            <Frame x:Name="SettingsFrame" />
        </NavigationView>
    </Grid>
</Page>

