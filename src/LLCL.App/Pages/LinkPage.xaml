<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.LinkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLCL.Pages"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="联机" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock x:Name="KernelText" Style="{StaticResource SubHeaderTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
                <Button x:Name="LeaveButton" Content="离开房间" Click="Leave_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- ===== 状态面板 ===== -->
                <Border x:Name="StatusPanel" Style="{StaticResource CardStyle}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="房间状态" FontSize="16" FontWeight="SemiBold" />
                                <Border x:Name="StateBadge" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                        CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="StateBadgeText" Text="未联机" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新"
                                    Click="RefreshStatus_Click" Visibility="Collapsed" />
                        </Grid>

                        <!-- 房间码 -->
                        <Grid x:Name="RoomCodeRow" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="房间码" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="RoomCodeText" FontFamily="Consolas" FontSize="18"
                                           FontWeight="SemiBold" IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="一键复制" VerticalAlignment="Center"
                                    Click="CopyCode_Click" />
                        </Grid>

                        <!-- 连接地址：端口转发模式下，加入者需通过该地址直连 -->
                        <Grid x:Name="ConnectAddressRow" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="连接地址" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ConnectAddressText" FontFamily="Consolas" FontSize="16"
                                           FontWeight="SemiBold" IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="在游戏中用「直接连接」填这个地址。局域网列表只扫描真实网卡，搜不到虚拟网络里的房间。"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="复制地址" VerticalAlignment="Top"
                                    Click="CopyAddress_Click" />
                        </Grid>

                        <!-- 四项指标 -->
                        <Grid x:Name="MetricsGrid" ColumnSpacing="8" RowSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="虚拟 IP" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="VirtualIpText" Text="—" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="Consolas" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="中继状态" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="RelayText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="延迟" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PingText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="在线人数" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="OnlineText" Text="—" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="RoomHintText" Style="{StaticResource SubHeaderTextStyle}"
                                   TextWrapping="Wrap" Visibility="Collapsed" />

                        <!-- 在线成员 -->
                        <StackPanel x:Name="PeerSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="在线成员" FontSize="13" FontWeight="SemiBold" />
                            <ListView x:Name="PeerList" SelectionMode="None" MaxHeight="160">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PeerItem">
                                        <Grid Padding="0,3" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Info}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                              </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 创建房间 ===== -->
                <Border x:Name="CreateCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="创建房间" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SubHeaderTextStyle}"
                                   Text="在 Minecraft 中打开“对局域网开放”，记下游戏显示的端口；扫描可自动发现，也可手动填写。" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WorldComboBox" Header="局域网世界（扫描结果）"
                                      HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="扫描" Click="Scan_Click"
                                    VerticalAlignment="Bottom" />
                            <NumberBox Grid.Column="2" x:Name="ManualPortBox" Header="手动端口"
                                       Minimum="1" Maximum="65535" Value="25565"
                                       SpinButtonPlacementMode="Inline" VerticalAlignment="Bottom" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HostNameBox" Header="你的昵称"
                                     PlaceholderText="留空则使用离线用户名" />
                            <Button Grid.Column="1" Content="创建房间"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Bottom" Click="Create_Click" />
                        </Grid>

                        <TextBlock x:Name="PortHintText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ===== 加入房间 ===== -->
                <Border x:Name="JoinCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="加入房间" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SubHeaderTextStyle}"
                                   Text="粘贴好友发来的房间码即可加入，端口已包含在房间码中。" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RoomCodeBox" PlaceholderText="房间码，例如 ABCDE-FGHIJ-KLMNO"
                                     TextChanged="RoomCodeBox_TextChanged" />
                            <Button Grid.Column="1" x:Name="JoinButton" Content="加入"
                                    Style="{StaticResource AccentButtonStyle}" Click="Join_Click" />
                        </Grid>

                        <TextBlock x:Name="JoinHintText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最近房间" FontSize="13" FontWeight="SemiBold" />
                                <HyperlinkButton Grid.Column="1" Content="清空" Padding="0"
                                                 Click="ClearHistory_Click" />
                            </Grid>
                            <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="150"
                                      IsItemClickEnabled="True" ItemClick="History_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryItem">
                                        <Grid Padding="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Code}" FontFamily="Consolas" FontSize="13" />
                                                <TextBlock Text="{x:Bind Summary}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Time}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 局域网发现 ===== -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="局域网世界" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SubHeaderTextStyle}"
                                   Text="自动发现同一局域网中已开放的多人游戏，点击即可填入端口。" />
                        <ListView x:Name="LanList" SelectionMode="None" MaxHeight="150"
                                  IsItemClickEnabled="True" ItemClick="Lan_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:LanItem">
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Display}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Source}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态条 -->
        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="False" IsClosable="True"
                 Severity="Informational" />
    </Grid>
</Page>


