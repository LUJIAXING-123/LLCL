<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLCL.Pages"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="关于" Style="{StaticResource SectionHeaderTextStyle}" />

        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Top">
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="32" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧图标（由代码加载，兼容打包与绿色模式） -->
                    <Grid Width="140" Height="140" VerticalAlignment="Center">
                        <Image x:Name="LogoSide" Stretch="Uniform" />
                        <Border x:Name="LogoFallback" Visibility="Collapsed"
                                CornerRadius="12" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                            <TextBlock Text="LLCL" FontSize="32" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <!-- 右侧文字 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="ProductTitle" Text="LL Craft Launcher"
                                   FontSize="34" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="StudioText" Text="Made by LL STUDIO"
                                   FontSize="15"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="0,14,0,10" HorizontalAlignment="Stretch" />

                        <TextBlock x:Name="VersionLine" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StageLine" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PathLine" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="ThanksLine" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 支持开发：点击按钮弹出收款码 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="支持开发" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="LLCL 完全免费且开源，所有功能都不收费。如果它帮到了你，欢迎支持后续开发，金额随意。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="微信赞助" Click="Donate_Click" />
                        <HyperlinkButton Content="GitHub 仓库" Click="Repo_Click" Padding="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
