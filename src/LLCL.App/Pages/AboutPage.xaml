<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="关于" Style="{StaticResource SectionHeaderTextStyle}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid ColumnSpacing="32" Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧图标 -->
                <Image Source="ms-appx:///Assets/llcl.png"
                       Width="140" Height="140" Stretch="Uniform"
                       VerticalAlignment="Center" />

                <!-- 右侧文字 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="ProductTitle" Text="LL Craft Launcher"
                               FontSize="34" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StudioText" Text="Made by LL STUDIO"
                               FontSize="15"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,14,0,10" HorizontalAlignment="Stretch" />

                    <TextBlock x:Name="VersionLine" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StageLine" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PathLine" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
