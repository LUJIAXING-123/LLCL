<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部问候与账号 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="GreetingText" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock x:Name="SubGreetingText" Style="{StaticResource SubHeaderTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AccountButton" VerticalAlignment="Center"
                    Click="AccountButton_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!--
                  启动卡片。
                  头像 64px，无边框，向上移 43px 使约 1/3 落在卡片内。
                  启动按钮贴右侧，尺寸参考微软商店的获取按钮。
                -->
                <Grid>
                    <Border Style="{StaticResource CardStyle}" Padding="20,36,20,20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="启动游戏" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CurrentVersionText"
                                               Style="{StaticResource SubHeaderTextStyle}" />
                                </StackPanel>

                                <ComboBox x:Name="VersionComboBox" HorizontalAlignment="Stretch"
                                          Header="游戏版本"
                                          SelectionChanged="VersionComboBox_SelectionChanged" />

                                <ProgressBar x:Name="LaunchProgress" IsIndeterminate="True" Value="0"
                                             Visibility="Collapsed" Height="3" />
                                <TextBlock x:Name="LaunchStageText" Visibility="Collapsed"
                                           Style="{StaticResource SubHeaderTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 启动按钮：整块色底 + 圆角，样式对齐微软商店 -->
                            <Button Grid.Column="2" x:Name="LaunchButton" Content="启动"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="52" MinWidth="200" Padding="32,0"
                                    CornerRadius="4" FontSize="16" FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Click="LaunchButton_Click" />
                        </Grid>
                    </Border>

                    <!-- 头像覆盖层：后声明位于上层，负上边距使其向上探出 -->
                    <Grid Width="64" Height="64"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="20,-43,0,0"
                          IsHitTestVisible="False">
                        <Image x:Name="AvatarImage" Stretch="Fill" />
                        <Border x:Name="AvatarFallback"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed">
                            <TextBlock x:Name="AvatarInitial" FontSize="26" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- 信息卡片 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="已安装版本" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionCountText" Style="{StaticResource SubHeaderTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="前往下载中心" Click="GoDownload_Click" />
                                <Button Content="管理此版本" Click="ManageVersion_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 联机状态卡片随联机入口一并隐藏 -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="联机状态" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="LinkStateText" Style="{StaticResource SubHeaderTextStyle}" />
                            <Button Content="打开联机页" Click="GoLink_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
