<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部问候与账号 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="GreetingText" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock x:Name="SubGreetingText" Style="{StaticResource SubHeaderTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AccountButton" VerticalAlignment="Center"
                    Click="AccountButton_Click" />
        </Grid>

        <!--
          卡片整体靠底：上面用 * 行占满剩余空间，内容放在 Auto 行。
          头像不能用负外边距探出，那样会被 ScrollViewer 裁掉；
          改用「预留一行空白」的方式，头像从第一行顶部开始画，
          卡片从第二行开始，探出部分自然不会被裁剪。
        -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!--
                      启动卡片。
                      第一行高 93px（约 2/3 头像高度 140），卡片从第二行开始，
                      于是头像上 93px 露在卡片外、下 47px 落在卡片内。
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 头像高 140，露出 70（约一半）在卡片外 -->
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                          布局：头像占左侧 140px 宽的一整块区域，
                          「启动游戏」与版本说明放在头像右侧，版本选择单独一行且靠左，
                          启动按钮贴右并横向拉长。
                          底部单独留一行放进度条，紧贴卡片下沿。
                        -->
                        <Border x:Name="AvatarCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="16" ColumnSpacing="16" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 标题与版本说明：位于头像右侧 -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="启动游戏" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CurrentVersionText"
                                                   Style="{StaticResource SubHeaderTextStyle}" />
                                    </StackPanel>

                                    <!-- 启动按钮：横向拉长，高度不变 -->
                                    <Button Grid.Column="2" x:Name="LaunchButton" Content="启动"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="220" Height="52" Padding="0"
                                            CornerRadius="4" FontSize="16" FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            Click="LaunchButton_Click" />

                                    <!-- 版本选择：跨满整行，从卡片最左开始 -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6">
                                        <ComboBox x:Name="VersionComboBox" HorizontalAlignment="Stretch"
                                                  Header="游戏版本"
                                                  SelectionChanged="VersionComboBox_SelectionChanged" />

                                        <TextBlock x:Name="LaunchStageText" Visibility="Collapsed"
                                                   Style="{StaticResource SubHeaderTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <!-- 进度条紧贴卡片底部：占满宽度，下沿与卡片圆角对齐 -->
                                <ProgressBar Grid.Row="1" x:Name="LaunchProgress"
                                             IsIndeterminate="True" Value="0"
                                             Height="4" CornerRadius="0,0,8,8"
                                             Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!--
                          头像：无边框，跨两行从顶部开始绘制。
                          第一行高 70px，头像高 140px，因此正好一半在卡片内。
                        -->
                        <Border x:Name="AvatarShadowHost"
                                Grid.Row="0" Grid.RowSpan="2"
                                Width="140" Height="140"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="16,0,0,0"
                                Background="Transparent"
                                IsHitTestVisible="False">
                            <Grid>
                                <Image x:Name="AvatarImage" Stretch="Fill" />
                                <Border x:Name="AvatarFallback"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="AvatarInitial" FontSize="56" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 信息卡片 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="已安装版本" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionCountText" Style="{StaticResource SubHeaderTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="前往下载中心" Click="GoDownload_Click" />
                                    <Button Content="管理此版本" Click="ManageVersion_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 联机状态卡片随联机入口一并隐藏 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="联机状态" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="LinkStateText" Style="{StaticResource SubHeaderTextStyle}" />
                                <Button Content="打开联机页" Click="GoLink_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
