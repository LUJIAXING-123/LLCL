<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部问候与账号 -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="GreetingText" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock x:Name="SubGreetingText" Style="{StaticResource SubHeaderTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AccountButton" VerticalAlignment="Center"
                    Click="AccountButton_Click" />
        </Grid>

        <!--
          卡片整体靠底：上面用 * 行占满剩余空间，内容放在 Auto 行。
          头像不能用负外边距探出，那样会被 ScrollViewer 裁掉；
          改用「预留一行空白」的方式，头像从第一行顶部开始画，
          卡片从第二行开始，探出部分自然不会被裁剪。
        -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!--
                      启动卡片。
                      第一行高 93px（约 2/3 头像高度 140），卡片从第二行开始，
                      于是头像上 93px 露在卡片外、下 47px 落在卡片内。
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="93" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                          上内边距 56px：头像落在卡片内的部分高 47px，
                          再留 9px 间隙，让正文从头像下方开始。
                          其余三边保持 16px，内容贴左，不留空列。
                        -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,56,16,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="启动游戏" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CurrentVersionText"
                                                   Style="{StaticResource SubHeaderTextStyle}" />
                                    </StackPanel>

                                    <ComboBox x:Name="VersionComboBox" HorizontalAlignment="Stretch"
                                              Header="游戏版本"
                                              SelectionChanged="VersionComboBox_SelectionChanged" />

                                    <ProgressBar x:Name="LaunchProgress" IsIndeterminate="True" Value="0"
                                                 Visibility="Collapsed" Height="3" />
                                    <TextBlock x:Name="LaunchStageText" Visibility="Collapsed"
                                               Style="{StaticResource SubHeaderTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 启动按钮：宽度与头像边长一致，样式对齐微软商店 -->
                                <Button Grid.Column="1" x:Name="LaunchButton" Content="启动"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Width="140" Height="52" Padding="0"
                                        CornerRadius="4" FontSize="16" FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Click="LaunchButton_Click" />
                            </Grid>
                        </Border>

                        <!-- 头像：无边框，跨两行从顶部开始绘制 -->
                        <Grid Grid.Row="0" Grid.RowSpan="2"
                              Width="140" Height="140"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="20,0,0,0"
                              IsHitTestVisible="False">
                            <Image x:Name="AvatarImage" Stretch="Fill" />
                            <Border x:Name="AvatarFallback"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="AvatarInitial" FontSize="56" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 信息卡片 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="已安装版本" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionCountText" Style="{StaticResource SubHeaderTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="前往下载中心" Click="GoDownload_Click" />
                                    <Button Content="管理此版本" Click="ManageVersion_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 联机状态卡片随联机入口一并隐藏 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="联机状态" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="LinkStateText" Style="{StaticResource SubHeaderTextStyle}" />
                                <Button Content="打开联机页" Click="GoLink_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
