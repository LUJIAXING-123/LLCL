<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LLCL.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LLCL.Pages"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="下载" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock x:Name="SourceText" Style="{StaticResource SubHeaderTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="下载设置" Click="SourceSettings_Click" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类 -->
            <Border Style="{StaticResource CardStyle}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    VerticalAlignment="Stretch" Padding="6">
                <StackPanel Spacing="2">
                    <TextBlock Text="游戏" FontSize="12" Margin="10,10,0,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="GameNav" SelectionMode="Single" SelectionChanged="Nav_SelectionChanged">
                        <ListViewItem Content="原版游戏" Tag="vanilla" />
                        <ListViewItem Content="模组加载器" Tag="loader" />
                    </ListView>

                    <TextBlock Text="资源" FontSize="12" Margin="10,14,0,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="ResourceNav" SelectionMode="Single" SelectionChanged="Nav_SelectionChanged">
                        <ListViewItem Content="模组" Tag="mod" />
                        <ListViewItem Content="整合包" Tag="modpack" />
                        <ListViewItem Content="资源包" Tag="resourcepack" />
                        <ListViewItem Content="光影" Tag="shader" />
                    </ListView>

                    <TextBlock Text="管理" FontSize="12" Margin="10,14,0,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="OtherNav" SelectionMode="Single" SelectionChanged="Nav_SelectionChanged">
                        <ListViewItem Content="下载任务" Tag="tasks" />
                    </ListView>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">

                <!-- 原版游戏 -->
                <Grid x:Name="PanelVanilla" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="原版游戏" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <AutoSuggestBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="搜索版本号"
                                        Width="220" TextChanged="Search_TextChanged" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="RadioRelease" Content="正式版" GroupName="Type" Checked="Type_Changed" />
                        <RadioButton x:Name="RadioSnapshot" Content="快照" GroupName="Type" Checked="Type_Changed" />
                        <RadioButton x:Name="RadioOld" Content="远古版本" GroupName="Type" Checked="Type_Changed" />
                        <RadioButton x:Name="RadioAll" Content="全部" GroupName="Type" Checked="Type_Changed" />
                    </StackPanel>

                    <ListView Grid.Row="2" x:Name="VersionList" SelectionMode="Single"
                              SelectionChanged="VersionList_SelectionChanged" IsItemClickEnabled="True"
                              ItemClick="VersionList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VersionItem">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind TypeDisplay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ReleaseDate}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 模组加载器 -->
                <Grid x:Name="PanelLoader" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="模组加载器" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="LoaderFabric" Content="Fabric" GroupName="Loader" Checked="Loader_Changed" />
                        <RadioButton x:Name="LoaderQuilt" Content="Quilt" GroupName="Loader" Checked="Loader_Changed" />
                        <RadioButton x:Name="LoaderForge" Content="Forge" GroupName="Loader" Checked="Loader_Changed" />
                        <RadioButton x:Name="LoaderNeoForge" Content="NeoForge" GroupName="Loader"
                                     Checked="Loader_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="McVersionCombo" Header="游戏版本" HorizontalAlignment="Stretch"
                                      SelectionChanged="McVersion_Changed" />
                            <ComboBox Grid.Column="1" x:Name="LoaderVersionCombo" Header="加载器版本"
                                      HorizontalAlignment="Stretch" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="LoaderSummary" Style="{StaticResource SubHeaderTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="LoaderNote" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="InstallLoaderButton" Content="下载并安装"
                                        Style="{StaticResource AccentButtonStyle}" Click="InstallLoader_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 社区资源 -->
                <Grid x:Name="PanelResource" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResourceTitle" Text="模组" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="ResourceVersionCombo" PlaceholderText="游戏版本" />
                        <ComboBox Grid.Column="2" x:Name="ResourceSourceCombo" SelectedIndex="0" />
                    </Grid>

                    <Grid Grid.Row="1" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox x:Name="ResourceSearchBox" PlaceholderText="搜索名称或描述"
                                        QuerySubmitted="ResourceSearch_Submitted" />
                        <ListView Grid.Row="1" x:Name="ResourceList" SelectionMode="Single"
                                  SelectionChanged="ResourceList_SelectionChanged" IsItemClickEnabled="True"
                                  ItemClick="ResourceList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ResourceCard">
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Source}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Summary}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Meta}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- 下载任务 -->
                <Grid x:Name="PanelTasks" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下载任务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="全部暂停" Click="PauseAll_Click" />
                            <Button Content="全部继续" Click="ResumeAll_Click" />
                            <Button Content="清除已完成" Click="PruneTasks_Click" />
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="1" x:Name="TaskList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TaskCard">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind State}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind Ratio}" Maximum="1" Height="4" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="暂停 / 继续" Tag="{x:Bind Id}" Click="PauseTask_Click" />
                                            <Button Content="取消并清理" Tag="{x:Bind Id}" Click="CancelTask_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- 底部操作条 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedText" Text="请选择一项" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallButton" Content="下载并安装"
                                Style="{StaticResource AccentButtonStyle}" Click="Install_Click"
                                IsEnabled="False" />
                        <Button x:Name="DetailButton" Content="版本设置" Click="Detail_Click" IsEnabled="False" />
                        <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Visibility="Collapsed" />
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Visibility="Collapsed" />
                        <Button x:Name="OpenFolderButton" Content="打开目录" Click="OpenFolder_Click" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Value="0" Maximum="1" Height="4"
                             Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
