<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <_LlclRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</_LlclRepoRoot>
    </PropertyGroup>
    <Import Project="$(_LlclRepoRoot)build\Version.props" />

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>LLCL.Core</RootNamespace>
        <AssemblyName>LLCL.Core</AssemblyName>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Description>LLCL 启动器核心库</Description>
        <Product>LL Craft Launcher</Product>
        <Company>LL STUDIO</Company>
        <Copyright>Copyright © LL STUDIO</Copyright>
    </PropertyGroup>

    <Target Name="LlclApplyVersion" BeforeTargets="PrepareForBuild;GenerateAssemblyInfo" DependsOnTargets="LlclReadVersion">
        <PropertyGroup>
            <Version>$(LlclVersion)</Version>
            <AssemblyVersion>$(_LlclAssemblyVersion)</AssemblyVersion>
            <FileVersion>$(_LlclFileVersion)</FileVersion>
            <InformationalVersion>$(LlclVersion)</InformationalVersion>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Forge / NeoForge 安装器外壳（约 4 KB）。
          源码位于 build/forge-shim/src，改动后用 build/build-forge-shim.ps1 重新生成。
          直接提交 jar 是为了让构建不依赖本机是否装了 JDK。
        -->
        <EmbeddedResource Include="Assets\forge-shim.jar" LogicalName="LLCL.Core.forge-shim.jar" />

        <!--
          模组中文名数据：gzip 压缩的 protobuf，沿用 PCL 内置的 mcmod.buf，
          原始数据整理自 mcmod.cn。仅用于按 slug 显示中文名称。
          若权利方认为不妥，请联系我们，会立即移除。
        -->
        <EmbeddedResource Include="Assets\mcmod.buf" LogicalName="LLCL.Core.mcmod.buf" />
    </ItemGroup>

    <Import Project="$(_LlclRepoRoot)build\Version.targets" />
</Project>

