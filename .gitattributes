# 统一换行符处理，避免跨平台提示 LF 将被替换为 CRLF
* text=auto eol=crlf

# 脚本保持 CRLF，Windows 下可直接双击运行
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 源码与配置允许 LF
*.cs text eol=crlf
*.xaml text eol=crlf
*.json text eol=lf
*.md text eol=lf

# 二进制文件不做换行转换
*.png binary
*.ico binary
*.jar binary
*.zip binary
*.msi binary
