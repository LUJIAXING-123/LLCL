<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
   build/msi/LLCL.wxs  —  LLCL 的 MSI 安装包模板（WiX 4）
  ============================================================
   由 build-msi.ps1 读取并替换两个占位符：
     @@DIRECTORY_TREE@@  目录层级声明
     @@FILE_COMPONENTS@@ File 与 Component 声明

   不使用 Util 扩展的 Files 元素（WiX 4 中该写法不被支持），
   改为由脚本扫描发布目录后生成标准 WiX 元素。
  ============================================================
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

    <Package
        Name="LL Craft Launcher"
        Manufacturer="LL STUDIO"
        Version="$(var.Version)"
        UpgradeCode="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D"
        Scope="perUser"
        Compressed="yes"
        InstallerVersion="500">

        <SummaryInformation
            Description="LL Craft Launcher 安装程序"
            Manufacturer="LL STUDIO" />

        <MajorUpgrade
            DowngradeErrorMessage="已安装更高版本的 LL Craft Launcher，请先卸载后再安装。" />

        <MediaTemplate EmbedCab="yes" />

        <!--
          安装到用户的 LocalAppData，避免要求管理员权限。
          与 PCL 等启动器的安装位置一致，也便于读取 .minecraft 与 LLCL 数据。
        -->
        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="INSTALLFOLDER" Name="LL Craft Launcher">
                @@DIRECTORY_TREE@@
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="AppMenuFolder" Name="LL Craft Launcher" />
        </StandardDirectory>

        <StandardDirectory Id="DesktopFolder" />

        <!-- ========== 功能 ========== -->
        <Feature Id="MainFeature" Title="LL Craft Launcher" Level="1">
            <ComponentGroupRef Id="MainFiles" />
        </Feature>

        <Feature Id="ShortcutFeature" Title="快捷方式" Level="1">
            <ComponentRef Id="StartMenuShortcut" />
            <ComponentRef Id="DesktopShortcut" />
        </Feature>

        <!-- 桌面快捷方式默认不装，用户通过「修改」可勾选 -->
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

        <!-- ========== 主程序文件（脚本生成） ========== -->
        <ComponentGroup Id="MainFiles">
            @@FILE_COMPONENTS@@
        </ComponentGroup>

        <!-- ========== 开始菜单快捷方式 ========== -->
        <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="*">
            <Shortcut Id="AppStartMenuShortcut"
                      Name="LL Craft Launcher"
                      Description="Minecraft 启动器"
                      Target="[INSTALLFOLDER]LLCL.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\LLSTUDIO\LLCL"
                           Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <!-- ========== 桌面快捷方式 ========== -->
        <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
            <Shortcut Id="AppDesktopShortcut"
                      Name="LL Craft Launcher"
                      Description="Minecraft 启动器"
                      Target="[INSTALLFOLDER]LLCL.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RegistryValue Root="HKCU" Key="Software\LLSTUDIO\LLCL"
                           Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <!-- ========== 控制面板信息 ========== -->
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPNOMODIFY" Value="1" />

        <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    </Package>
</Wix>


