<Project>
    <UsingTask TaskName="LlclWriteBuildInfo" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <FilePath ParameterType="System.String" Required="true" />
            <Version ParameterType="System.String" Required="true" />
            <Stage ParameterType="System.String" Required="true" />
            <BuildTime ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Code Type="Fragment" Language="cs"><![CDATA[
var text = $@"// <auto-generated />
// 由 build/Version.targets 生成，请勿手工修改。
namespace LLCL.Core;

/// <summary>构建时注入的版本信息。</summary>
public static class BuildInfo
{{
    /// <summary>完整版本号，例如 0.1.0-dev.1。</summary>
    public const string Version = ""{Version}"";

    /// <summary>发布阶段：dev / beta / preview / rc / release。</summary>
    public const string Stage = ""{Stage}"";

    /// <summary>构建时间（UTC）。</summary>
    public static readonly System.DateTime BuildTimeUtc = System.DateTime.Parse(""{BuildTime}"");
}}
";
System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(FilePath));
System.IO.File.WriteAllText(FilePath, text);
]]></Code>
        </Task>
    </UsingTask>

    <Target Name="LlclGenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="LlclReadVersion">
        <PropertyGroup>
            <_LlclBuildInfoDir>$(IntermediateOutputPath)Generated/</_LlclBuildInfoDir>
            <_LlclBuildInfoFile>$(_LlclBuildInfoDir)BuildInfo.g.cs</_LlclBuildInfoFile>
            <_LlclBuildTime>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</_LlclBuildTime>
        </PropertyGroup>

        <LlclWriteBuildInfo FilePath="$(_LlclBuildInfoFile)"
                             Version="$(LlclVersion)"
                             Stage="$(LlclStage)"
                             BuildTime="$(_LlclBuildTime)" />

        <ItemGroup>
            <Compile Include="$(_LlclBuildInfoFile)" Visible="false" />
            <FileWrites Include="$(_LlclBuildInfoFile)" />
        </ItemGroup>
    </Target>
</Project>
